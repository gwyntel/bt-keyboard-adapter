[Unit]
Description=BLE HID Keyboard Adapter (HID over GATT)
After=bluetooth.service
Wants=bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=%i
Group=input
WorkingDirectory=/opt/bt-keyboard-adapter
ExecStart=/usr/bin/python3 /opt/bt-keyboard-adapter/ble_keyboard.py --input /dev/input/event0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
